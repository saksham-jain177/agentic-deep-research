# Copy this file to `.env` and fill in your own values. Never commit the real .env.

# --- Required for research ---
# Tavily API key (https://tavily.com) - web search backend
TAVILY_API_KEY=tvly-your-key-here

# --- Required for drafting/verification ---
# OpenRouter API key (https://openrouter.ai). OPENAI_API_KEY is accepted as a
# fallback name by all model-calling modules.
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional alias (used if OPENROUTER_API_KEY is unset)
# OPENAI_API_KEY=sk-or-your-key-here
# API endpoint (defaults to OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Model selection (optional) ---
# Primary model; free-tier default shown
# OPENROUTER_MODEL=tngtech/deepseek-r1t2-chimera:free
# Comma-separated fallback chain used on rate limits / empty responses
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free
# Specialized module overrides
# EVIDENCE_EXTRACTOR_MODEL=meta-llama/llama-3.3-70b-instruct:free
# VERIFICATION_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Research behavior (optional) ---
# Per-request web search timeout in seconds
# RESEARCH_TIMEOUT_SECONDS=60
# Domains excluded from search results (comma-separated, matched on the
# registrable domain - subdomains are included, unrelated domains are not)
# EXCLUDE_DOMAINS=reddit.com,x.com,twitter.com,tiktok.com,pinterest.com,instagram.com
# Prefer previously cached vector-store results before hitting the web
# PREFER_CACHE_RESULTS=false
# Reranker: how many results to keep after cross-encoder reranking
# RERANK_TOP_K=10
# Write fetched results to research_data.json (debugging only)
# DEBUG_DUMP_RESEARCH=false

# --- Vector memory (optional) ---
# Enables the ChromaDB-backed research cache (requires first run to download
# the embedding model)
# ENABLE_VECTOR_STORE=false

# --- Drafting (optional) ---
# Global token budget per report (auto-estimated when unset)
# TOKEN_BUDGET_PER_REPORT=

# --- Verification / contradiction detection (optional) ---
# Force a language for verification prompts (e.g. en, es, de); empty = auto
# VERIFICATION_LANGUAGE=
# CONTRADICTION_LANGUAGE=

# --- Feedback form (optional, OFF by default) ---
# The sidebar feedback form emails itself via Gmail SMTP. Because it is
# unauthenticated, it is disabled unless you explicitly enable it here and
# provide credentials. Leave unset on any publicly deployed instance.
# FEEDBACK_ENABLED=false
# FEEDBACK_BOT_EMAIL=you@gmail.com
# FEEDBACK_BOT_PASSWORD=your-gmail-app-password
